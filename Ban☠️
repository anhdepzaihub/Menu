-- Hiệu ứng Animation xuất hiện mượt mà (Fade in & Slide)
local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

TweenService:Create(background, tweenInfo, {BackgroundTransparency = 0.2}):Play()
TweenService:Create(mainFrame, tweenInfo, {
    BackgroundTransparency = 0,
    Position = UDim2.new(0.5, -240, 0.5, -155)
}):Play()

TweenService:Create(title, tweenInfo, {TextTransparency = 0}):Play()
TweenService:Create(message, tweenInfo, {TextTransparency = 0}):Play()
TweenService:Create(leaveBtn, tweenInfo, {BackgroundTransparency = 0, TextTransparency = 0}):Play()

-- Hiệu ứng đổi màu nền animation lặp lại liên tục (Đỏ cảnh báo <-> Tối)
task.spawn(function()
    while task.wait() do
        local colorTween1 = TweenService:Create(background, TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundColor3 = Color3.fromRGB(45, 10, 10)})
        colorTween1:Play()
        colorTween1.Completed:Wait()
        
        local colorTween2 = TweenService:Create(background, TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundColor3 = Color3.fromRGB(15, 15, 15)})
        colorTween2:Play()
        colorTween2.Completed:Wait()
    end
end)

