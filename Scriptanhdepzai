local CURRENT_VERSION = "1.0" -- Phiên bản hiện tại của script
-- Thay đường dẫn bên dưới bằng link Raw GitHub hoặc Pastebin chứa mã nguồn script mới nhất của bạn
local SCRIPT_URL = "https://raw.githubusercontent.com/anh2k9VN/AnhDepZaiHub/main/main.lua" 
local VERSION_URL = "https://raw.githubusercontent.com/anh2k9VN/AnhDepZaiHub/main/version.txt"

task.spawn(function()
    local success, remoteVersion = pcall(function()
        return game:HttpGet(VERSION_URL)
    end)
    
    if success and remoteVersion then
        remoteVersion = remoteVersion:gsub("%s+", "") -- Xóa khoảng trắng thừa
        if remoteVersion ~= CURRENT_VERSION then
            print("[AnhDepZai Hub] Phát hiện phiên bản mới! Đang tự động cập nhật...")
            local updateSuccess, newScript = pcall(function()
                return game:HttpGet(SCRIPT_URL)
            end)
            if updateSuccess and newScript then
                -- Thực thi script mới ngay lập tức
                pcall(function()
                    loadstring(newScript)()
                end)
                print("[AnhDepZai Hub] Cập nhật thành công phiên bản mới!")
                return
            end
        else
            print("[AnhDepZai Hub] Script đang ở phiên bản mới nhất (" .. CURRENT_VERSION .. ").")
        end
    else
        print("[AnhDepZai Hub] Không thể kiểm tra cập nhật (Kiểm tra lại kết nối hoặc URL).")
    end
end)

